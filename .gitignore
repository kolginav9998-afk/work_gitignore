# Игнорируем всё виртуальное окружение Python
venv/

# Игнорируем папки с кешем интерпретатора Python
__pycache__/

# Игнорируем все файлы с расширением .log
*.log

# Игнорируем скрытые файлы настроек редактора (например, для VSCode)
.vscode/
.idea/

# (Опционально) Игнорируем файл с чувствительными данными (пароли, ключи)
.env

# PRIME: локальные/CI сборочные артефакты и рантайм-данные - не коммитим
prime_project/build/*.ods
prime_project/dist/*.ods
prime_project/**/Backups/
prime_project/**/Diagnostics/*.log
prime_project/**/Acts/
prime_project/**/Exports/
*.lock
.~lock.*#